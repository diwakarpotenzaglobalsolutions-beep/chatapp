rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function protectedSubscriptionFields() {
      return [
        'subscriptionStatus',
        'trialStartDate',
        'trialEndDate',
        'subscriptionStartDate',
        'subscriptionEndDate',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'stripePriceId',
        'trialUsed',
        'planName',
        'billingPeriod'
      ];
    }

    function isNotUpdatingSubscriptionFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(protectedSubscriptionFields());
    }

    function isInitializingTrial() {
      return resource.data.trialUsed != true
        && request.resource.data.trialUsed == true
        && request.resource.data.subscriptionStatus in ['trialing', 'expired'];
    }

    function isUpdatingPaidSubscription() {
      return request.resource.data.subscriptionStatus in ['active', 'past_due', 'canceled', 'payment_failed', 'expired', 'trialing']
        && request.resource.data.stripeSubscriptionId is string
        && request.resource.data.stripeSubscriptionId.size() > 0;
    }

    function canUpdateSubscriptionFields() {
      return isInitializingTrial() || isUpdatingPaidSubscription();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) && (
        isNotUpdatingSubscriptionFields() || canUpdateSubscriptionFields()
      );
      allow delete: if isOwner(userId);
    }

    match /chat_rooms/{roomId} {
      allow read, write: if isAuthenticated() &&
        (request.auth.uid in resource.data.participants ||
         request.auth.uid in request.resource.data.participants);

      match /messages/{messageId} {
        allow read, write: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;
      }
    }

    match /chat_requests/{requestId} {
      allow read, write: if isAuthenticated() &&
        (request.auth.uid == resource.data.senderId ||
         request.auth.uid == resource.data.receiverId ||
         request.auth.uid == request.resource.data.senderId ||
         request.auth.uid == request.resource.data.receiverId);
    }
  }
}
